{
  "name": "skills-demo-agent-web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "skills-demo-agent-web": "dist/server/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run build:web && tsx src/server/index.ts",
    "check": "tsc --noEmit",
