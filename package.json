    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.88",
    "@anthropic-ai/claude-agent-sdk": "^0.2.39",
    "ai": "^6.0.86",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vitest": "^4.0.18"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  }
