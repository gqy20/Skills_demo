# MinerU API (必需 - 用于 PDF 转 Markdown)
MINERU_API_KEY=your_mineru_api_key_here

# Anthropic Claude API (可选 - 用于生成摘要)
ANTHROPIC_AUTH_TOKEN=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Zhipu API Key (可选 - MCP / BigModel 相关服务)
ZHIPU_API_KEY=your_zhipu_api_key

# Notion MCP (可选 - 官方开源本地 MCP)
# 获取: https://www.notion.so/profile/integrations -> Internal Integration Token
NOTION_TOKEN=ntn_your_notion_integration_token

# Zotero MCP (可选 - kujenga/zotero-mcp)
# 默认 Web API 模式: ZOTERO_LOCAL=false，并配置 ZOTERO_API_KEY / ZOTERO_LIBRARY_ID
# 本地 Zotero 模式: ZOTERO_LOCAL=true (通常不需要 API key)
# Zotero Key 获取: https://www.zotero.org/settings/keys
ZOTERO_LOCAL=false
ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_LIBRARY_ID=your_zotero_library_id_here
ZOTERO_LIBRARY_TYPE=user

# 并行处理配置 (可选)
PDF_MAX_WORKERS=5
PDF_ENABLE_PARALLEL=true
